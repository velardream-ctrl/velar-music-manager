// RUN-065 — STAGED Cloud Storage rules. NOT DEPLOYED.
// Do not replace any existing live Storage rules before backing them up.
// Only public artist portraits, never private music or lyrics.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function studioAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && firestore.exists(/databases/(default)/documents/vmm_admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/vmm_admins/$(request.auth.uid)).data.enabled == true;
    }
    match /public/artist-avatars/{artistId}/{fileName} {
      allow get: if artistId.matches('^[a-z0-9-]{1,80}$')
        && fileName.matches('^[0-9]{13}-[0-9a-f]{16}[.](webp|jpg)$');
      allow list: if false;
      allow create: if studioAdmin()
        && artistId.matches('^[a-z0-9-]{1,80}$')
        && fileName.matches('^[0-9]{13}-[0-9a-f]{16}[.](webp|jpg)$')
        && request.resource.size > 0
        && request.resource.size <= 320 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)');
      allow update: if false;
      allow delete: if studioAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
