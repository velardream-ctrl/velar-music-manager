// VELARDREAM private studio. STAGED RULES — NOT DEPLOYED.
// Deploy only to the NEW separate Firebase project after owner enrollment.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInGoogle() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function adminPath() {
      return /databases/$(database)/documents/vmm_admins/$(request.auth.uid);
    }
    function studioAdmin() {
      return signedInGoogle()
        && exists(adminPath())
        && get(adminPath()).data.enabled == true;
    }
    match /vmm_admins/{uid} {
      // The owner creates each admin document manually via Firebase Console/Admin SDK.
      // A user can inspect their own status, but nobody can self-enroll.
      allow get: if signedInGoogle() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    // RUN-061 / RUN-098. Public landing content is entirely separate from private VMM.
    // RUN-098: album gallery is an explicit sixth top-level public field.
    // Never relax these rules to expose vmm_catalog, vmm_lyrics, or private drafts.
    // STAGED ONLY: merge into actual production rules after comparing with
    // the currently deployed rules. Never replace live rules blindly.
    function validLandingWrite(status) {
      return studioAdmin()
        && request.resource.data.keys().hasOnly([
          'schemaVersion','status','revision','content','updatedAt','updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion','status','revision','content','updatedAt','updatedBy'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.status == status
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.content is map
        && request.resource.data.content.keys().hasOnly([
          'hero','artists','albums','releases','genres','about'
        ])
        && request.resource.data.content.keys().hasAll([
          'hero','artists','albums','releases','genres','about'
        ])
        && request.resource.data.content.hero is map
        && request.resource.data.content.artists is map
        && request.resource.data.content.albums is map
        && request.resource.data.content.albums.entries is list
        && request.resource.data.content.albums.entries.size() <= 8
        && request.resource.data.content.releases is map
        && request.resource.data.content.genres is map
        && request.resource.data.content.about is map
        && request.resource.data.content.artists.cards is list
        && request.resource.data.content.artists.cards.size() <= 12
        && request.resource.data.content.releases.cards is list
        && request.resource.data.content.releases.cards.size() <= 12
        && request.resource.data.content.genres.tags is list
        && request.resource.data.content.genres.tags.size() <= 20;
    }
    match /vmm_public_drafts/{pageId} {
      allow get: if pageId == 'landing' && studioAdmin();
      allow list, delete: if false;
      allow create, update: if pageId == 'landing' && validLandingWrite('draft');
    }
    match /vmm_public_pages/{pageId} {
      // Anonymous visitors can retrieve ONLY the one approved landing doc.
      // No listing / private docs are exposed.
      // An admin must be able to read the document even before the first
      // publication, when resource does not exist yet.
      allow get: if pageId == 'landing'
        && (studioAdmin()
          || (resource != null
            && resource.data.status == 'published'
            && resource.data.schemaVersion == 1));
      allow list, delete: if false;
      allow create, update: if pageId == 'landing' && validLandingWrite('published');
    }
    match /vmm_lyrics/{itemId} { allow read, write: if studioAdmin(); }
    match /vmm_catalog/{itemId} { allow read, write: if studioAdmin(); }
    match /vmm_recordings/{itemId} { allow read, write: if studioAdmin(); }
    match /vmm_platforms/{itemId} { allow read, write: if studioAdmin(); }
    match /vmm_links/{itemId} { allow read, write: if studioAdmin(); }
    match /vmm_contacts/{itemId} { allow read, write: if studioAdmin(); }
    match /vmm_outreach/{itemId} { allow read, write: if studioAdmin(); }
    match /vmm_audit/{itemId} { allow read, write: if studioAdmin(); }
    // Forum accounts may sign in by email. Studio authorization remains Google-only.
    function forumWriter() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function forumSectionPath(id) {
      return /databases/$(database)/documents/velar_forum_sections/$(id);
    }
    function forumCategory(value) {
      return value is string && value.matches('^[a-zA-Z0-9_-]{1,32}$')
        && (exists(forumSectionPath(value))
          ? get(forumSectionPath(value)).data.enabled == true
          : value in ['site', 'ideas', 'collaboration', 'releases']);
    }

    match /velar_forum_settings/public {
      allow get: if true;
      allow create, update: if studioAdmin()
        && request.resource.data.keys().hasOnly(['title', 'subtitle'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.subtitle is string
        && request.resource.data.subtitle.size() <= 100;
    }

    match /velar_forum_sections/{sectionId} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow create, update: if studioAdmin()
        && sectionId.matches('^[a-zA-Z0-9_-]{1,32}$')
        && request.resource.data.keys().hasOnly(['label', 'icon', 'order', 'enabled', 'deleted'])
        && request.resource.data.label is string
        && request.resource.data.label.size() >= 2 && request.resource.data.label.size() <= 60
        && request.resource.data.icon is string
        && request.resource.data.icon.size() >= 1 && request.resource.data.icon.size() <= 12
        && request.resource.data.order is int
        && request.resource.data.order >= 0 && request.resource.data.order <= 9999
        && request.resource.data.enabled is bool
        && request.resource.data.get('deleted', false) is bool
        && (!request.resource.data.get('deleted', false) || !request.resource.data.enabled);
      allow delete: if false;
    }
    function forumPost(data, maximum) {
      return forumWriter()
        && !exists(/databases/$(database)/documents/velar_forum_bans/$(request.auth.uid))
        && data.uid == request.auth.uid
        && data.author is string && data.author.size() >= 2 && data.author.size() <= 32
        && data.body is string && data.body.size() >= 1 && data.body.size() <= maximum
        && data.visible == true && data.createdAt == request.time;
    }
    function forumModeration() {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.visible is bool && (
        (studioAdmin() && changes.hasOnly(['visible', 'deleted'])
          && request.resource.data.get('deleted', false) is bool
          && (!request.resource.data.get('deleted', false) || !request.resource.data.visible))
        || (forumWriter() && resource.data.uid == request.auth.uid
          && !request.resource.data.visible && changes.hasOnly(['visible']))
      );
    }

    match /velar_forum_members/{uid} {
      function ownProfile() {
        return request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'password';
      }
      function validProfile() {
        let data = request.resource.data;
        return data.keys().hasOnly(['name', 'email', 'verified', 'joinedAt'])
          && data.email == request.auth.token.email
          && data.verified == request.auth.token.email_verified
          && data.name is string && data.name.size() <= 32;
      }
      allow get: if ownProfile() || studioAdmin();
      allow list: if studioAdmin() && request.query.limit <= 100;
      allow create: if ownProfile() && validProfile() && request.resource.data.joinedAt == request.time;
      allow update: if ownProfile() && validProfile() && request.resource.data.joinedAt == resource.data.joinedAt;
    }

    match /velar_forum_bans/{uid} {
      allow get: if studioAdmin();
      allow list: if studioAdmin() && request.query.limit <= 100;
      allow create, update: if studioAdmin() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['author', 'createdAt'])
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 32
        && request.resource.data.createdAt == request.time;
      allow delete: if studioAdmin();
    }

    function forumTopicVisible(topicId) {
      return get(/databases/$(database)/documents/velar_forum_topics/$(topicId)).data.visible == true;
    }
    match /velar_forum_topics/{topicId} {
      allow get: if studioAdmin() || resource.data.visible == true;
      allow list: if request.query.limit <= 100 && (studioAdmin() || resource.data.visible == true);
      allow create: if request.resource.data.keys().hasOnly([
          'uid', 'author', 'body', 'visible', 'createdAt', 'category', 'title'
        ])
        && forumPost(request.resource.data, 3000)
        && forumCategory(request.resource.data.category)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100;
      allow update: if forumModeration();
      allow delete: if false;
      match /replies/{replyId} {
        allow get: if studioAdmin() || (forumTopicVisible(topicId) && resource.data.visible == true);
        allow list: if request.query.limit <= 100 && (studioAdmin() || (forumTopicVisible(topicId) && resource.data.visible == true));
        allow create: if forumTopicVisible(topicId)
          && request.resource.data.keys().hasOnly(['uid', 'author', 'body', 'visible', 'createdAt'])
          && forumPost(request.resource.data, 2000);
        allow update: if forumModeration();
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
